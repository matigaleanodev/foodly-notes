{
  "name": "foodly-notes",
  "version": "1.1.3",
  "author": "Matias Galeano",
  "homepage": "https://foodly-notes.web.app",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:vitest",
    "test:ci": "npm run test:vitest:ci",
    "test:vitest": "ng run app:test-vitest:ci",
    "test:vitest:browser": "ng run app:test-vitest-browser:ci",
    "test:vitest:ci": "npm run test:vitest && npm run test:vitest:browser",
    "lint": "ng lint",
    "i18n:check": "npx tsc --ignoreConfig --module Node16 --moduleResolution Node16 --types node --outDir .angular/i18n-check scripts/check-missing-keys.ts && node .angular/i18n-check/scripts/check-missing-keys.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/angular": "^9.0.7",
    "@ionic/storage-angular": "^4.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/language-service": "^22.2.2",
    "@capacitor/cli": "^8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser-playwright": "^5.0.3",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "description": "Frontend for Foodly Notes, providing recipe search, translations, and shopping list support",
  "repository": {
    "type": "git",
    "url": "https://github.com/matigaleanodev/foodly-notes"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
