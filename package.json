{
  "name": "foodly-notes",
  "version": "1.1.1",
  "author": "Matias Galeano",
  "homepage": "https://foodly-notes.web.app",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:vitest",
    "test:ci": "npm run test:vitest:ci",
    "test:vitest": "ng run app:test-vitest:ci",
    "test:vitest:browser": "ng run app:test-vitest-browser:ci",
    "test:vitest:ci": "npm run test:vitest && npm run test:vitest:browser",
    "lint": "ng lint",
    "i18n:check": "npx tsc scripts/check-missing-keys.ts && node scripts/check-missing-keys.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@capacitor/android": "8.0.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.0.2",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/angular": "^8.7.17",
    "@ionic/storage-angular": "^4.0.0",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^21.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.2.0",
    "@angular-eslint/schematics": "^21.2.0",
    "@angular-eslint/template-parser": "^21.2.0",
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.3",
    "@angular/language-service": "^21.1.3",
    "@capacitor/cli": "8.0.2",
    "@ionic/angular-toolkit": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/browser-playwright": "^4.0.18",
    "chokidar": "^4.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.0.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "readdirp": "^4.1.2",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "description": "Frontend for Foodly Notes, providing recipe search, translations, and shopping list support",
  "repository": {
    "type": "git",
    "url": "https://github.com/matigaleanodev/foodly-notes"
  },
  "engines": {
    "node": ">=22"
  }
}
